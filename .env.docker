# WeatherNFT Docker Environment Variables
# Copy this file to .env before deploying with Docker

# ============================================
# DEPLOYMENT MODE
# ============================================
NODE_ENV=production

# ============================================
# MONGODB CONFIGURATION
# ============================================
# Root credentials (for MongoDB admin)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Application credentials (used by services)
MONGO_APP_PASSWORD=CHANGE_ME_ANOTHER_STRONG_PASSWORD

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# ============================================
# SECURITY - JWT & SESSION
# ============================================
# Generate strong secrets with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET_MIN_64_CHARACTERS
JWT_EXPIRATION=24h
SESSION_SECRET=REPLACE_WITH_ANOTHER_STRONG_SECRET

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://weathernft.com,https://www.weathernft.com,https://app.weathernft.com

# ============================================
# IPFS CONFIGURATION
# ============================================
IPFS_PROVIDER=pinata
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here

# ============================================
# BLOCKCHAIN CONFIGURATION
# ============================================
TEZOS_RPC_URL=https://mainnet.api.tez.ie
TEZOS_PRIVATE_KEY=edsk...
NFT_CONTRACT_ADDRESS=KT1...
EVENT_CONTRACT_ADDRESS=KT1...

# ============================================
# WEATHER API KEYS
# ============================================
OPENWEATHER_API_KEY=your_openweathermap_api_key
WEATHERAPI_KEY=your_weatherapi_key
NOAA_API_KEY=your_noaa_api_key

# ============================================
# AI CONFIGURATION
# ============================================
SD_AI_URL=http://ai-service:8000
USE_REAL_AI=true

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# DOCKER REGISTRY (optional)
# ============================================
# For production deployments with private registry
REGISTRY=docker.io/weathernft
TAG=latest
