    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "ethers": "^6.15.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-winston": "^4.2.0",
    "form-data": "^4.0.0",
