{
  "name": "weather-nft-live",
  "version": "2.0.0",
  "description": "Revolutionary NFT project that captures unique weather moments as tradeable digital assets with real AI-powered weather prediction using PyTorch and SD environment.",
  "main": "src/frontend/simple-frontend-server.js",
  "scripts": {
    "start": "node src/frontend/simple-frontend-server.js",
    "build": "echo 'Build completed'",
    "dev": "./scripts/restart-all.sh",
    "test": "jest --coverage",
    "test:unit": "jest --testMatch='**/*.test.js'",
    "test:watch": "jest --watch",
    "backend": "node src/backend/simple-server.js",
    "admin": "node src/backend/admin-backend.js",
    "auth": "node src/backend/auth-service.js",
    "blockchain": "node src/backend/blockchain-service.js",
    "nft": "node src/backend/nft-service.js",
    "guild": "node src/backend/guild-service.js",
    "analytics": "node src/backend/analytics-service.js",
    "websocket": "node src/backend/websocket-service.js",
    "weather": "node src/backend/weather-api-service.js",
    "marketplace": "node src/backend/marketplace-service.js",
    "demo": "node demo-user-experience.js",
    "db:init": "node src/backend/db-manager.js init",
    "db:seed": "node src/backend/db-manager.js seed",
    "db:health": "node src/backend/db-manager.js health",
    "db:stats": "node src/backend/db-manager.js stats",
