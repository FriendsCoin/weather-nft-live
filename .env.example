# WeatherNFT Environment Configuration

# Server Ports
PORT=8081
AI_BACKEND_PORT=3006
BLOCKCHAIN_PORT=3007
ADMIN_PORT=3008
NFT_SERVICE_PORT=3009
GUILD_SERVICE_PORT=3010
ANALYTICS_PORT=3011
WEBSOCKET_PORT=8080
WEATHER_API_PORT=3012
MARKETPLACE_PORT=3013
AUTH_SERVICE_PORT=3014

# IPFS Configuration
IPFS_PROVIDER=pinata  # Options: 'pinata', 'infura', 'local'

# Pinata (recommended for production)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here

# Infura (alternative)
INFURA_PROJECT_ID=your_infura_project_id
INFURA_PROJECT_SECRET=your_infura_project_secret

# Local IPFS Node (for development)
LOCAL_IPFS_URL=http://localhost:5001

# Tezos Blockchain
TEZOS_RPC_URL=https://ghostnet.ecadinfra.com
TEZOS_PRIVATE_KEY=edsk...
NFT_CONTRACT_ADDRESS=KT1...
EVENT_CONTRACT_ADDRESS=KT1...

# MongoDB
MONGODB_URI=mongodb://localhost:27017/weathernft
MONGODB_DB_NAME=weathernft

# Redis (required for token blacklist / logout functionality)
REDIS_URL=redis://localhost:6379

# Weather APIs
OPENWEATHER_API_KEY=your_openweathermap_api_key
WEATHERAPI_KEY=your_weatherapi_key
NOAA_API_KEY=your_noaa_api_key

# AI Configuration
SD_AI_URL=http://localhost:8000
USE_REAL_AI=false

# Security (REQUIRED FOR PRODUCTION)
# Generate strong JWT secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRATION=24h
SESSION_SECRET=your_session_secret_here

# CORS Configuration (comma-separated list for production)
ALLOWED_ORIGINS=https://weathernft.com,https://app.weathernft.com

# Logging
LOG_LEVEL=info
SERVICE_NAME=weathernft

# Environment
NODE_ENV=development
