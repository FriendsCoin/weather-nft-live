# WeatherNFT Environment Configuration

# Server Ports
PORT=8081
AI_BACKEND_PORT=3006
BLOCKCHAIN_PORT=3007
ADMIN_PORT=3008
NFT_SERVICE_PORT=3009
GUILD_SERVICE_PORT=3010
ANALYTICS_PORT=3011
WEBSOCKET_PORT=8080
WEATHER_API_PORT=3012
MARKETPLACE_PORT=3013
AUTH_SERVICE_PORT=3014

# IPFS Configuration
IPFS_PROVIDER=pinata  # Options: 'pinata', 'infura', 'local'

# Pinata (recommended for production)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here

# Infura (alternative)
INFURA_PROJECT_ID=your_infura_project_id
INFURA_PROJECT_SECRET=your_infura_project_secret

# Local IPFS Node (for development)
LOCAL_IPFS_URL=http://localhost:5001

# Tezos Blockchain
TEZOS_RPC_URL=https://ghostnet.ecadinfra.com
TEZOS_PRIVATE_KEY=edsk...
NFT_CONTRACT_ADDRESS=KT1...
EVENT_CONTRACT_ADDRESS=KT1...

# MongoDB
MONGODB_URI=mongodb://localhost:27017/weathernft
MONGODB_DB_NAME=weathernft

# Redis (required for token blacklist / logout functionality)
REDIS_URL=redis://localhost:6379

# Weather APIs
OPENWEATHER_API_KEY=your_openweathermap_api_key
WEATHERAPI_KEY=your_weatherapi_key
NOAA_API_KEY=your_noaa_api_key

# AI Configuration
SD_AI_URL=http://localhost:8000
USE_REAL_AI=false

# Modern Image Generators (multi-provider, auto-fallback to procedural)
# Set IMAGE_PROVIDER to force one, otherwise the registry picks the best
# available by priority: stability > fal > replicate > openai > self-hosted SD.
# IMAGE_PROVIDER=stability
SD_API_STYLE=simple            # 'simple' (project SD) or 'a1111' (AUTOMATIC1111)
STABILITY_API_KEY=             # https://platform.stability.ai
STABILITY_MODEL=core           # 'core' | 'ultra' | 'sd3' | 'sd3-large'
OPENAI_API_KEY=                # gpt-image-1 / dall-e-3
OPENAI_IMAGE_MODEL=gpt-image-1
REPLICATE_API_TOKEN=           # FLUX via Replicate
REPLICATE_MODEL=black-forest-labs/flux-schnell
FAL_KEY=                       # FLUX/SDXL via fal.ai
FAL_MODEL=fal-ai/flux/schnell

# Autonomous Agent (WeatherHunter)
AGENT_PORT=3013
AGENT_INTERVAL_MS=300000       # scan cycle period (default 5 min)
AGENT_DRY_RUN=false            # true = detect & decide but never mint
AGENT_MIN_CONFIDENCE=0.6       # policy floor for acting
AGENT_RARITIES=rare,epic,legendary
AGENT_MAX_PER_CYCLE=5          # cap actions per scan cycle
AGENT_DAILY_BUDGET=50          # cap actions per rolling 24h
AGENT_AUTH_TOKEN=              # bearer token the agent uses to mint
WEATHER_API_URL=http://localhost:3012
NFT_SERVICE_URL=http://localhost:3009
WEBSOCKET_URL=http://localhost:8080

# Security (REQUIRED FOR PRODUCTION)
# Generate strong JWT secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRATION=24h
SESSION_SECRET=your_session_secret_here

# CORS Configuration (comma-separated list for production)
ALLOWED_ORIGINS=https://weathernft.com,https://app.weathernft.com

# Logging
LOG_LEVEL=info
SERVICE_NAME=weathernft

# Environment
NODE_ENV=development
